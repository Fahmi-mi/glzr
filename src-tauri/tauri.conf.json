{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "glzr",
  "version": "0.1.0",
  "identifier": "io.github.fahmi-mi.glzr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "glzr",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "externalBin": ["binaries/rg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["git"]
      }
    }
  },
  "plugins": {
    "cli": {
      "description": "glzr - terminal-first workspace for Linux",
      "args": [
        {
          "name": "folder",
          "index": 1,
          "description": "Folder path to open"
        }
      ]
    }
  }
}
